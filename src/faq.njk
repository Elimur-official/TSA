---
layout: base.njk
title: Помощь — elimur
permalink: /faq/
---
<h1>Помощь</h1>
<div class="faq-list">
  {% for item in faq.items %}
  <details class="faq-item">
    <summary>{{ item.question }}</summary>
    <p>{{ item.answer }}</p>
  </details>
  {% endfor %}
</div>

<section id="wb-promo" class="wb-promo">
  <span class="badge">{{ faq.wbPromo.code }}</span>
  <h3>{{ faq.wbPromo.title }}</h3>
  <p>{{ faq.wbPromo.text }}</p>
  <a href="https://t.me/{{ site.telegramBotUsername }}" class="btn btn--primary">Написать нам</a>
</section>
