---
layout: base.njk
title: Помощь — elimur
description: Ответы на частые вопросы elimur — оформление заказа, анонимность доставки, сроки, оплата, возврат и гарантия на товары.
permalink: /faq/
---
<h1>Помощь</h1>
<div class="faq-list">
  {% for item in faq.items %}
  <details class="faq-item">
    <summary>{{ item.question }}</summary>
    <p>{{ item.answer }}</p>
  </details>
  {% endfor %}
</div>

<section id="wb-promo" class="wb-promo">
  <span class="badge">{{ faq.wbPromo.code }}</span>
  <h3>{{ faq.wbPromo.title }}</h3>
  <p>{{ faq.wbPromo.text }}</p>
  {% if site.wbPromoCode %}
  <div class="promo-code-row">
    <code class="promo-code">{{ site.wbPromoCode }}</code>
    <button class="btn btn--primary" data-copy="{{ site.wbPromoCode }}">Скопировать</button>
  </div>
  <p class="promo-note">Назовите код менеджеру в чате</p>
  {% endif %}
  <a href="https://t.me/{{ site.telegramBotUsername }}" class="btn btn--ghost">Написать нам</a>
</section>
