<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or "elimur — интимные товары для взрослых" }}</title>
<link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="elimur">
<meta property="og:title" content="{{ title or 'elimur — интимные товары для взрослых' }}">
<meta property="og:description" content="{{ description or 'Анонимная доставка по России. Нейтральная упаковка. Заказ через Telegram за 2 минуты.' }}">
<meta property="og:image" content="{{ site.baseUrl }}{{ ogImage or '/images/products/placeholder.svg' }}">
<meta name="twitter:card" content="summary">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
<!-- Yandex.Metrika counter -->
<script type="text/javascript">
   (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
   m[i].l=1*new Date();
   for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
   k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
   (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

   ym({{ site.yandexMetrikaId }}, "init", {
        clickmap:true,
        trackLinks:true,
        accurateTrackBounce:true
   });
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ site.yandexMetrikaId }}" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<!-- /Yandex.Metrika counter -->
<!-- Место под пиксель ретаргетинга (VK/Яндекс Директ) — вставить при запуске рекламной кампании -->
</head>
<body>
<div id="age-gate" class="age-gate">
  <div class="age-gate__box">
    <div class="age-gate__logo">elimur</div>
    <h1>Вам уже есть 18 лет?</h1>
    <p>Здесь товары для взрослых 18+. Заходя, вы подтверждаете свой возраст.</p>
    <button id="age-yes" class="btn btn--primary btn--full">Да, мне есть 18</button>
    <button id="age-no" class="btn btn--ghost btn--full">Нет, мне ещё нет</button>
    <p id="age-denied" class="age-gate__denied" hidden>Извините, доступ разрешён только совершеннолетним.</p>
  </div>
</div>

<header class="site-header">
  <a href="/" class="logo">elimur</a>
  <nav>
    <a href="/">Каталог</a>
    <a href="/articles/">Гайды</a>
    <a href="/reviews/">Отзывы</a>
    <a href="/about/">О нас</a>
    <a href="/faq/">Помощь</a>
  </nav>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="site-footer__cols">
    <div class="site-footer__col">
      <h4>Покупателям</h4>
      <a href="/faq/">Доставка и оплата</a>
      <a href="/faq/">Возврат и гарантия</a>
      <a href="/faq/">Анонимность</a>
      <a href="https://t.me/{{ site.telegramBotUsername }}">Написать в Telegram</a>
    </div>
    <div class="site-footer__col">
      <h4>Реквизиты</h4>
      <span>{{ site.legal.form }}</span>
      <span>ОГРНИП {{ site.legal.ogrnip }}</span>
      <span>ИНН {{ site.legal.inn }}</span>
    </div>
  </div>
  <p class="site-footer__bottom">© elimur · Только для взрослых 18+</p>
</footer>

<script>window.YM_ID = {{ site.yandexMetrikaId }};</script>
<script src="/js/age-gate.js"></script>
<script src="/js/analytics.js"></script>
<script src="/js/promo-copy.js"></script>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="/js/miniapp.js"></script>
</body>
</html>
