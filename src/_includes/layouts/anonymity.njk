---
layout: base.njk
---
<h1>{{ heading }}</h1>
<p class="anonymity__intro">{{ intro }}</p>
<div class="anonymity">
  {% for s in sections %}
  <section class="anonymity__section">
    <h3>{{ s.title }}</h3>
    <p>{{ s.body }}</p>
  </section>
  {% endfor %}
</div>
{% if photos.length %}
<div class="anonymity__photos">
  {% for ph in photos %}<img src="{{ ph }}" alt="Так выглядит посылка elimur" loading="lazy">{% endfor %}
</div>
{% endif %}
<a href="https://t.me/{{ site.telegramBotUsername }}" class="btn btn--primary">Задать вопрос в Telegram</a>
