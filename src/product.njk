---
pagination:
  data: products
  size: 1
  alias: product
permalink: "/product/{{ product.id }}/"
layout: base.njk
eleventyComputed:
  title: "{{ product.name }} — elimur"
  description: "{{ product.description }}"
  ogImage: "{{ product.image }}"
---
<a href="/" class="back-link">← Каталог</a>

<div class="product-detail">
  <img src="{{ product.image }}" alt="{{ product.name }}" class="product-detail__photo">
  <div class="product-detail__info">
    <span class="product-detail__category">{{ product.category }}</span>
    <h1>{{ product.name }}</h1>
    {% if product.rating and product.reviewsCount %}
    <p class="product-detail__rating">★ {{ product.rating }} · {{ product.reviewsCount }} отзывов на Wildberries</p>
    {% endif %}
    <div class="product-detail__price">
      {% if product.oldPrice and product.oldPrice > product.price %}<s class="price-old">{{ product.oldPrice }} ₽</s> {% endif %}{{ product.price }} ₽{% if product.oldPrice and product.oldPrice > product.price %} <span class="badge badge--discount">−{{ ((1 - product.price / product.oldPrice) * 100) | round }}%</span>{% endif %}
    </div>
    <p class="product-detail__description">{{ product.description }}</p>

    {% if product.inStock %}<p class="product-detail__stock">В наличии · отправка 1–3 дня</p>{% endif %}

    <a
      href="https://t.me/{{ site.telegramBotUsername }}?start=product_{{ product.id }}"
      class="btn btn--primary btn--full"
      data-analytics="order-click"
      data-product-id="{{ product.id }}"
    >Заказать в 1 клик</a>
    <p class="product-detail__cta-note">Откроется чат в Telegram с менеджером —<br>оформление за 2 минуты, без звонков</p>

    <p class="product-detail__trust">Анонимная отправка 1–3 дня. Нейтральная коробка — без названия магазина и намёка на содержимое.</p>

    {% if product.specs %}
    <section class="product-specs">
      <h3>Характеристики</h3>
      <dl>
        {% for s in product.specs %}
        <div class="product-specs__row">
          <dt>{{ s.key }}</dt>
          <dd>{{ s.value }}</dd>
        </div>
        {% endfor %}
      </dl>
    </section>
    {% endif %}

    {% set miniFaq = faq.items | faqPick(["Доставка правда анонимная?", "Сколько идёт доставка?", "Можно ли вернуть товар?"]) %}
    {% if miniFaq.length %}
    <section class="product-detail__faq">
      <h3>Частые вопросы</h3>
      {% for item in miniFaq %}
      <details class="faq-item">
        <summary>{{ item.question }}</summary>
        <p>{{ item.answer }}</p>
      </details>
      {% endfor %}
    </section>
    {% endif %}
  </div>

  {% if collections.reviews.length %}
  <section class="product-detail__reviews">
    <h3>Что говорят покупатели</h3>
    {% for review in collections.reviews | limit(2) %}
    <div class="review-card">
      <div class="review-card__head">
        <span>{{ review.data.name }}</span>
        <span>{{ review.data.rating | stars }}</span>
      </div>
      <p class="review-card__meta">{{ review.date | ruDate }}{% if review.data.city %} · {{ review.data.city }}{% endif %} · <span class="review-card__wb">покупка на Wildberries</span></p>
      <div class="review-card__text">{{ review.templateContent | safe }}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}
</div>
